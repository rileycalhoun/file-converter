# The only process that receives this value is the private gateway.
CLOUDCONVERT_API_KEY=

# Generate with: openssl rand -hex 32
# Enter this same value in the Tauri app's Settings screen.
GATEWAY_TOKEN=

# Bind behind an HTTPS reverse proxy in production.
BIND_ADDRESS=127.0.0.1:8080

# Use https://sandbox.api.cloudconvert.com while developing if desired.
CLOUDCONVERT_API_BASE=https://api.cloudconvert.com

RUST_LOG=file_converter_gateway=info,tower_http=info
