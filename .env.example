# Generate with: openssl rand -hex 32
# Enter this same value in the Tauri app's Settings screen.
GATEWAY_TOKEN=

# Host port published by compose.yaml. It binds to loopback only.
GATEWAY_PORT=8080

# Used when running the gateway directly with Cargo. Compose overrides these
# with the container addresses on its private network.
BIND_ADDRESS=127.0.0.1:8080
GOTENBERG_URL=http://127.0.0.1:3000

RUST_LOG=file_converter_gateway=info,tower_http=info
